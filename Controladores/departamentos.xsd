<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://ejemplo.org/departamentos"
           xmlns="http://ejemplo.org/departamentos"
           elementFormDefault="qualified">

  <xs:simpleType name="CDDType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z][0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="codigoPostType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="direccionType">
    <xs:sequence>
      <xs:element name="calle" type="xs:string"/>
      <xs:element name="ciudad" type="xs:string"/>
      <xs:element name="codigoPostal" type="codigoPostType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="departamentoType">
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="director" type="xs:string"/>
      <xs:element name="empleados">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="empleado" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="direccion" type="direccionType"/>
    </xs:sequence>
    <xs:attribute name="CDD" type="CDDType" use="required"/>
  </xs:complexType>

  <xs:element name="departamento" type="departamentoType"/>
</xs:schema>
