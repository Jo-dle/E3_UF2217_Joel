<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tc="http://ejemplo.org/tiposComunes"
           targetNamespace="http://ejemplo.org/empleados"
           xmlns="http://ejemplo.org/empleados"
           elementFormDefault="qualified">

  <xs:import namespace="http://ejemplo.org/tiposComunes" schemaLocation="tiposComunes.xsd"/>

  <xs:simpleType name="CEDType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z][0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="sexoType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[H]|[M]"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="departamentoType">
    <xs:restriction base="xs:string">
      <xs:pattern value="Limpieza|Producción|Contabilidad|Mantenimiento"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="empleadoType">
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="sexo" type="sexoType"/>
      <xs:element name="contacto">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="email" type="tc:emailType"/>
            <xs:element name="telefono" type="tc:telefonoType"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="departamento" type="departamentoType"/>
    </xs:sequence>
    <xs:attribute name="CED" type="CEDType" use="required"/>
  </xs:complexType>

  <xs:element name="empleado" type="empleadoType"/>
</xs:schema>
